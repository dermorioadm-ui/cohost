# =============================================================================
# HospedePay — Backend
# Copie para .env e preencha. NUNCA versione o .env preenchido.
# As chaves marcadas [obrigatória] precisam existir para o backend subir.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE  [obrigatória]
# Painel: Project Settings > API  |  Connect > ORMs (DB_URL)
# -----------------------------------------------------------------------------
SUPABASE_URL="https://SEU_PROJETO.supabase.co"
SUPABASE_PROJECT_ID="SEU_PROJETO"
SUPABASE_PUBLISHABLE_KEY=""          # chave pública (vai no frontend)
SUPABASE_SERVICE_ROLE_KEY=""         # segredo. só backend/edge functions
SUPABASE_DB_URL=""                   # postgres://... para rodar migrations

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
APP_BASE_URL="https://app.seudominio.com.br"   # base dos links (chat, convites)
APP_TIMEZONE="America/Sao_Paulo"
APP_DEFAULT_LOCALE="pt"
APP_ENV="production"                            # production | staging | development

# -----------------------------------------------------------------------------
# STRIPE  [obrigatória para cobrança]
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""              # whsec_... do endpoint /stripe-webhook

# Preços (Stripe > Catálogo de produtos > preço > ID)
STRIPE_PRICE_ESSENCIAL_MONTHLY=""
STRIPE_PRICE_ESSENCIAL_ANNUAL=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_ILIMITADO_MONTHLY=""
STRIPE_PRICE_ILIMITADO_ANNUAL=""

# -----------------------------------------------------------------------------
# IA — assistente do hóspede
# Escolha UM provider em AI_PROVIDER e preencha a chave correspondente.
# -----------------------------------------------------------------------------
AI_PROVIDER="anthropic"               # anthropic | google | openai-compatible
AI_MODEL=""                           # vazio = usa o default do provider
AI_MAX_OUTPUT_TOKENS="800"

ANTHROPIC_API_KEY=""                  # console.anthropic.com
GOOGLE_AI_API_KEY=""                  # aistudio.google.com
OPENAI_COMPATIBLE_API_KEY=""          # qualquer gateway compatível com /v1/chat/completions
OPENAI_COMPATIBLE_BASE_URL=""

# -----------------------------------------------------------------------------
# E-MAIL TRANSACIONAL  [obrigatória para portaria/relatórios]
# -----------------------------------------------------------------------------
EMAIL_PROVIDER="resend"               # resend | sendgrid | smtp
RESEND_API_KEY=""
SENDGRID_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

EMAIL_FROM_ADDRESS="nao-responda@seudominio.com.br"
EMAIL_FROM_NAME="HospedePay"
EMAIL_REPLY_TO="suporte@seudominio.com.br"

# -----------------------------------------------------------------------------
# WHATSAPP — Meta Cloud API
# Enquanto a verificação da Meta não sai, deixe WHATSAPP_ENABLED=false:
# o backend gera links wa.me para envio manual e nada quebra.
# -----------------------------------------------------------------------------
WHATSAPP_ENABLED="false"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""              # você inventa; usado no webhook da Meta
WHATSAPP_TEMPLATE_CLEANER_INVITE="convite_diarista"
WHATSAPP_TEMPLATE_NEW_RESERVATION="nova_reserva"

# -----------------------------------------------------------------------------
# PORTARIA DIGITAL (Kiper/Porter) — credenciais são POR IMÓVEL,
# gravadas em porter_accounts. Aqui só o que é global.
# -----------------------------------------------------------------------------
PORTER_API_BASE_URL="https://api.cloud.kiper.com.br"
PORTER_ENABLED="true"

# -----------------------------------------------------------------------------
# JOBS / CRON
# Segredo compartilhado: o pg_cron chama as functions com este header.
# Gere com: openssl rand -hex 32
# -----------------------------------------------------------------------------
CRON_SECRET=""

# -----------------------------------------------------------------------------
# OBSERVABILIDADE (opcional)
# -----------------------------------------------------------------------------
SENTRY_DSN=""
LOG_LEVEL="info"                      # debug | info | warn | error
