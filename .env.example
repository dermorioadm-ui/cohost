# "online" | "offline" | "auto" (auto lê VITE_LP_STATUS_URL, que responde {"online":true}).
VITE_LP_ESTADO="online"
VITE_LP_STATUS_URL=""
# Vídeo de 15s da seção "Prova" e foto da seção "Quem responde" (URLs ou caminhos em /public).
